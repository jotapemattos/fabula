{
  "name": "fabula-ts",
  "version": "0.0.0",
  "description": "A headless bookshelf core built on Effect",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
